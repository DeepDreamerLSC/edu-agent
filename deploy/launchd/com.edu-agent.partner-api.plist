<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- 合作方对话服务(00 §5.2):四端点 + SSE + 身份两端点 + /healthz,端口 8300。
     同一环境只此一个服务、一个端口(04 §2.1;M0 的 healthz 独立进程已删)。
     __DEPLOY_ROOT__ / __ENV_NAME__ 占位符由 deploy.sh 按实际部署替换后写入
     ~/Library/LaunchAgents/。凭据不进本文件:启动器按 EDU_ENV 读部署目录的
     .env.<ENV>(600、gitignored)——launchd 不继承 shell 环境,读文件是唯一真相源。 -->
<dict>
  <key>Label</key>
  <string>com.edu-agent.partner-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/linsuchang/.local/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/serve_partner_api.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEPLOY_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>EDU_ENV</key>
    <string>__ENV_NAME__</string>
    <key>EDU_PARTNER_API_PORT</key>
    <string>8300</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/linsuchang/Library/Logs/edu-agent/partner-api.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/linsuchang/Library/Logs/edu-agent/partner-api.log</string>
  <key>LimitLoadToSessionType</key>
  <array>
    <string>Aqua</string>
    <string>Background</string>
  </array>
</dict>
</plist>
