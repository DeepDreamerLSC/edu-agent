     --parallel 4 开 4 解码槽(burst T2 P95 79s 根因=单槽×网关 2 并发排队);
     --ctx-size 为槽间总量,8192→32768 保持每槽 8k。实验性质,回滚线=本文件与
     configs/models.yaml(tutor concurrency)同时回退 + launchctl 重载即回单槽。 -->
<dict>
  <key>Label</key>
  <string>com.edu-agent.m0.vision-8303</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/llama-server</string>
    <string>--model</string>
    <string>/Users/linsuchang/Desktop/work/models/Qwen3-VL-8B-GGUF/Qwen3VL-8B-Instruct-Q4_K_M.gguf</string>
    <string>--mmproj</string>
    <string>/Users/linsuchang/Desktop/work/models/Qwen3-VL-8B-GGUF/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf</string>
    <string>--host</string>
    <string>127.0.0.1</string>
