{"schema_version": "small_lecturer_image_teaching/v1", "scenario_id": "image_v1_percentage_multi_part_23", "candidate_idx": 23, "title": "percentage_multi_part (5-1百分数的意义(1))", "grade": "六年级", "question": {"text": "我们学校的女生人数占全校学生人数的49%。(两校各49%)这两个学校的女生人数一定相同吗?为什么?反思:用彩色笔分别涂出下面各图面积的25%,涂色的小方块一样多吗?想一想这是为什么?(图1:10×10格 图2:5×10格)", "image": {"path": "pqfile_04ebc0048b42c1a5fe6e118b.jpg", "sha256": "630e69be2d49107aae1d38f3654c859bd7c80d874542569ee76889a774ebc276"}}, "reference_answer": {"value": "不一定相同(总人数不同);格子数不同(整体不同)", "answer_type": "text", "unit": ""}, "bucket": "percentage_multi_part", "visual_dependency": "helpful", "misconception_seed": "把百分比误当绝对数/相同百分比误当相同数量", "difficulty": "hard", "source": {"question_id": "6a69e6862ef3251197be2a0c", "provider": "pujia_school_question_bank", "lesson_name": "5-1百分数的意义(1)"}, "state": "candidate"}
