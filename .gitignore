__pycache__/
*.pyc
.venv/
.env
*.jsonl
!evals/datasets/**/*.jsonl
!edu_agent/evals/datasets/**/*.jsonl
!edu_agent/evals/artifacts/**/*.jsonl
# 测试夹具真原件形态目录(#368 适配:夹具须随仓走,CI 才能跑 importer e2e)
!tests/fixtures/**/*.jsonl
.DS_Store
.ruff_cache/
.pytest_cache/

# mimosa 插件 hook 状态(2026-09-06 误入库,见 issue 后续):本地工具产物,永不入库
.mimosa/

# 部署环境差异文件(04 §2.1:ENV 只差一个 .env),凭据不进仓库
.env.*

# 部署台账与基准报告等本地产物(04 §2.1 JSONL / benchmark report)
var/

# 会话文件 store(M3 PR6 FileSessionStore)的运行时产物,本地状态不入库
# (同 var/ 口径,04 §2.1)
data/

# 外部数据冻结原件(#368:license 兼容性核对人批后另行拉取,不入库)
/external/
# zcode 运行时配置(会话级,含钩子路径;存档工作流 .zcode/workflows/ 需进 git,故排除法)
.zcode/*
!.zcode/workflows/
